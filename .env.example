# Trace — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ─── Core Security ────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
TRACE_SECRET_KEY=your-32-byte-hex-secret-key-here

# Enable HTTPS (required for secure cookies, HSTS)
# Set to "true" only when running behind a valid TLS terminator (nginx, Caddy, etc.)
TRACE_HTTPS=false

# ─── Rate Limiting ────────────────────────────────────────────────────────
# Enable/disable rate limiting
TRACE_RATELIMIT=true

# ─── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# Include your production domain(s) when deploying
TRACE_CORS_ORIGINS=http://localhost:5001,http://127.0.0.1:5001

# ─── Debug ────────────────────────────────────────────────────────────────
# NEVER enable in production!
# When true: detailed error messages, no security headers that break dev
TRACE_DEBUG=false

# ─── Production Deployment (Optional) ────────────────────────────────────
# Database (if adding persistence later)
# DATABASE_URL=postgresql://user:pass@localhost/trace

# Redis (for distributed rate limiting / sessions)
# REDIS_URL=redis://localhost:6379/0

# Logging
# LOG_LEVEL=INFO
# LOG_FILE=/var/log/trace/app.log